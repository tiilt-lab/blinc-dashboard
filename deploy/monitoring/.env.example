# Copy to .env (git-ignored) before `docker compose up -d`.
# Where Alertmanager POSTs alerts (Slack/Discord/Matrix/any webhook receiver).
ALERT_WEBHOOK_URL=https://example.invalid/blinc-alerts
# Grafana admin login (127.0.0.1:3000).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Public URL if an nginx route is added later (otherwise leave the default).
GRAFANA_ROOT_URL=http://127.0.0.1:3000/
